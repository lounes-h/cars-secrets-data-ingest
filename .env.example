# Copy to .env or let ./start.sh generate it with random secrets.
POSTGRES_PASSWORD=change-me
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=at-least-32-random-characters-change-me
HOST_UID=1000
HOST_GID=1000
DASHBOARD_PORT=8080
POSTGRES_PORT=5433
# The API's database (cars-secrets-api), which the worker keeps in step. By default the local
# api-db service; set API_DATABASE_URL to a hosted Postgres instead (?sslmode=require).
API_POSTGRES_PASSWORD=change-me
API_POSTGRES_PORT=5434
# API_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# A removed lot stays in the API database until its sale time + this (auctions run 2-4 h).
API_KEEP_AFTER_SALE_MINUTES=240
# Providers expected to deliver files (comma-separated); each gets a staleness check.
ENABLED_PROVIDERS=copart
# Alert when no export has been ingested for this long (exports arrive hourly).
STALE_AFTER_MINUTES=75
ARCHIVE_RETENTION_DAYS=7
# Warn when a file's row count differs from the recent average by more than this share.
ROW_COUNT_DEVIATION_RATIO=0.3
# A lot missing from an export is only marked removed once its sale time + this has passed.
REMOVAL_GRACE_MINUTES=120
# Set to true when the dashboard is served over HTTPS.
COOKIE_SECURE=false
# Auction data APIs with final sale prices, checked by `python -m ingest.api_check`.
# APIBARA_API_KEY=
# APIAUCTIONS_TOKEN=
# AI damage analysis of a lot ("Generate AI Analysis" on the lot page), run by the worker:
# at most AI_MAX_IMAGES photos per analysis, their longest side shrunk to AI_IMAGE_MAX_PX.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_MAX_IMAGES=5
# AI_IMAGE_MAX_PX=1024
# AI_LANGUAGE=en
